# MongoDB Atlas credentials
DB_USER=
DB_PASS=
DB_HOST=cluster0.pbd6wjw.mongodb.net
DB_NAME=shopDB

# Stripe SECRET key (sk_test_... locally, sk_live_... in production)
PAYMENT_GATEWAY_KEY=
# Optional: signing secret of the Stripe webhook pointing to /webhooks/stripe
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Firebase service account JSON, base64 encoded (node convertKey.js)
FB_SERVICE_KEY=

# imgbb API key for admin image uploads (kept on the server, never in the client bundle)
IMGBB_KEY=

# Comma separated storefront origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Comma separated emails that become admin when they sign in
ADMIN_EMAILS=

NODE_ENV=development
PORT=5000
